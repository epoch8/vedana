# MCP client (vedana-core connecting out to remote MCP servers - requires the `mcp` extra,
# `pip install vedana-core[mcp]`). Distinct from libs/vedana-mcp (the MCP *server* side, whose
# own settings also use an MCP_ prefix for its auth fields - don't confuse the two).
# JSON list of servers whose tools are added to the rag agent. URL must include the /mcp path:
# MCP_SERVERS=[{"name": "salary", "url": "https://example.com/mcp", "token": "..."}]
# MCP_CALL_TIMEOUT=120
